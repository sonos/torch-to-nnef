# Modified Bessel function of the first kind, order 1 (`I_1(x)`).
# Abramowitz & Stegun 9.8.3 / 9.8.4 polynomial approximations.
#
# Two branches selected by `|x| < 3.75`:
#   small: `x * (0.5 + sum_{k=1..6} a_k * ((x/3.75)^2)^k)`
#   large: `sign(x) * exp(|x|) / sqrt(|x|) * sum_{k=0..8} b_k * (3.75/|x|)^k`
#
# `exp(|x|)` overflows in f32 for `|x| > ~88`; use `i1e` for the
# scaled-exponential form when working with large magnitudes.
fragment i1(input: tensor<scalar>) -> (output: tensor<scalar>)
{
    abs_x    = abs(input);
    is_small = lt(abs_x, 3.75);

    t_small = sqr(input / 3.75);
    poly_small = 0.5 + t_small * (0.87890594
                + t_small * (0.51498869
                + t_small * (0.15084934
                + t_small * (0.02658733
                + t_small * (0.00301532
                + t_small * 0.00032411)))));
    i1_small = input * poly_small;

    # Safe `3.75 / |x|` for the large branch: clamp the divisor away
    # from 0 so the small-x path doesn't propagate inf / NaN through
    # the `select` (only the kept branch matters but tract evaluates
    # both eagerly).
    safe_abs   = max(abs_x, 3.75);
    t_large    = 3.75 / safe_abs;
    poly_large = 0.39894228 + t_large * (-0.03988024
                + t_large * (-0.00362018
                + t_large * (0.00163801
                + t_large * (-0.01031555
                + t_large * (0.02282967
                + t_large * (-0.02895312
                + t_large * (0.01787654
                + t_large * -0.00420059)))))));
    i1_mag    = exp(safe_abs) / sqrt(safe_abs) * poly_large;
    i1_large  = sign(input) * i1_mag;

    output = select(is_small, i1_small, i1_large);
}
