# Phase of a complex tensor stored in t2n's `(..., 2)` real layout:
# `angle = atan2(imag, real)` where real / imag are slices on `axis`
# (always `rank(input) - 1` for the standard `torch.angle` call; the
# emitter passes it explicitly so this fragment stays rank-agnostic).
# Delegates the four-quadrant arithmetic to the `atan2` fragment.
fragment angle(
    input: tensor<scalar>,
    axis:  integer
) -> ( output: tensor<scalar> )
{
    re_full = slice(input, axes = [axis], begin = [0], end = [1], stride = [1]);
    im_full = slice(input, axes = [axis], begin = [1], end = [2], stride = [1]);
    re      = squeeze(re_full, axes = [axis]);
    im      = squeeze(im_full, axes = [axis]);
    output  = atan2(im, re);
}
