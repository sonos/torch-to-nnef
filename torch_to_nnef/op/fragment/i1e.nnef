# Exponentially-scaled `I_1`: `i1e(x) = exp(-|x|) * I_1(x)`. Same
# polynomial branches as `i1` (Abramowitz & Stegun 9.8.3 / 9.8.4);
# the large-x branch drops the `exp(|x|)` factor entirely, so the
# result stays finite for arbitrarily large `|x|` (useful when
# combining with other Bessel-family terms in stable forms).
fragment i1e(input: tensor<scalar>) -> (output: tensor<scalar>)
{
    abs_x    = abs(input);
    is_small = lt(abs_x, 3.75);

    t_small = sqr(input / 3.75);
    poly_small = 0.5 + t_small * (0.87890594
                + t_small * (0.51498869
                + t_small * (0.15084934
                + t_small * (0.02658733
                + t_small * (0.00301532
                + t_small * 0.00032411)))));
    i1_small  = input * poly_small;
    i1e_small = i1_small * exp(0.0 - abs_x);

    safe_abs   = max(abs_x, 3.75);
    t_large    = 3.75 / safe_abs;
    poly_large = 0.39894228 + t_large * (-0.03988024
                + t_large * (-0.00362018
                + t_large * (0.00163801
                + t_large * (-0.01031555
                + t_large * (0.02282967
                + t_large * (-0.02895312
                + t_large * (0.01787654
                + t_large * -0.00420059)))))));
    i1e_mag    = poly_large / sqrt(safe_abs);
    i1e_large  = sign(input) * i1e_mag;

    output = select(is_small, i1e_small, i1e_large);
}
