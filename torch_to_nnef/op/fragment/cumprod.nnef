extension tract_registry tract_core;


fragment scan_body_mul(
    scan_input: tensor<scalar>,
    acc_input: tensor<scalar>
) -> ( multiplied: tensor<scalar> )
{
    multiplied = scan_input * acc_input;
}


fragment tract_cumprod(
    input: tensor<scalar>,
    init: tensor<scalar>,
    axis: integer
) -> ( output: tensor<scalar> )
{
    output = tract_core_scan(
        body = "scan_body_mul",
        scan = [
            ("scan_input", input, axis, 1)
        ],
        full = [],
        state = [("acc_input", init, "multiplied")],
        output = [("multiplied", "full", axis, 1)],
        skip = 0,
        reset_every_turn = false
    );
}
